
const D=JSON.parse(document.getElementById('data').textContent);
const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nf=new Intl.NumberFormat('ru-RU',{maximumFractionDigits:0}), pf=new Intl.NumberFormat('ru-RU',{minimumFractionDigits:1,maximumFractionDigits:1});
const f=n=>n==null?'н/д':nf.format(n), pct=n=>n==null?'н/д':pf.format(n)+'%', money=n=>f(n)+' ₽', rate=(n,d)=>d?n/d*100:null;
const bandNames=['0–5%','5–10%','10–15%','15–20%','20–25%','25–30%','30–35%','>35%'];
const colors=['#9dded0','#64c5b8','#48a3ce','#72aaff','#9d96f2','#c596ed','#ee9ec6','#ffba70'];
function agg(rows){let due=rows.filter(r=>r.due),renew=due.filter(r=>r.renewed),valid=renew.filter(r=>r.valid),grow=valid.filter(r=>r.delta>0),flat=valid.filter(r=>r.delta===0),drop=valid.filter(r=>r.delta<0),non=due.filter(r=>r.non),accepted=due.filter(r=>r.accepted);let sum=(rs,k)=>rs.reduce((s,r)=>s+(r[k]??0),0),n=due.length;return {base:rows.length,base_money:sum(rows,'old'),due:n,due_money:sum(due,'old'),renew:renew.length,renew_old_money:sum(renew,'old'),renew_new_money:sum(renew,'new'),accepted:accepted.length,accepted_gain:sum(accepted,'delta'),grow:grow.length,flat:flat.length,drop:drop.length,non:non.length,unknown:renew.length-valid.length,gain:sum(grow,'delta'),reduction:-sum(drop,'delta'),non_money:sum(non,'old'),idle_loss:sum(non,'idle_loss'),bins:colors.map((_,i)=>grow.filter(r=>r.band===i).length),renew_rate:rate(renew.length,n),grow_rate:rate(grow.length,n),accept_rate:rate(accepted.length,n),safe_rate:rate(grow.length+flat.length,n),score:n?(50*renew.length+30*accepted.length+20*(grow.length+flat.length))/n:null};}
function selected(){const s=$('#scope').value,m=$('#manager').value;return D.clients.filter(r=>(s==='all'||(s==='virtual'?r.virtual:!r.virtual))&&(!m||r.manager===m));}
function groups(rows){return [...new Set(rows.map(r=>r.manager))].map(name=>({name,virtual:rows.some(r=>r.manager===name&&r.virtual),...agg(rows.filter(r=>r.manager===name))}));}
function table(el,heads,rows){$(el).innerHTML='<thead><tr>'+heads.map(h=>'<th>'+h+'</th>').join('')+'</tr></thead><tbody>'+rows.join('')+'</tbody>';}
function tr(cells,cls=''){return '<tr class="'+cls+'">'+cells.map(c=>'<td>'+c+'</td>').join('')+'</tr>';}
function refill(){const old=$('#manager').value,s=$('#scope').value;const names=D.managers.filter(m=>s==='all'||(s==='virtual'?m.virtual:!m.virtual)).map(m=>m.name);$('#manager').innerHTML='<option value="">Все выбранные</option>'+names.map(n=>'<option value="'+esc(n)+'">'+esc(n)+'</option>').join('');$('#manager').value=names.includes(old)?old:'';}
function progress(n){return '<div class="progress"><span style="width:'+Math.min(100,n||0)+'%"></span></div>';}
function render(){let rows=selected(),a=agg(rows),g=groups(rows);const humans=g.filter(x=>!x.virtual).sort((x,y)=>(y.score??-1)-(x.score??-1));
$('#kpis').innerHTML=[
['Приняли повышение ≥15%',pct(a.accept_rate),f(a.accepted)+' из '+f(a.due)+' клиентов с наступившим продлением','Объём не уменьшился<br>Любой положительный рост: '+pct(a.grow_rate)],
['Заработали дополнительно*','+'+money(a.gain),f(a.grow)+' клиентов с положительным ростом','Из них принявшие ≥15%: +'+money(a.accepted_gain)],
['База команды · клиенты',f(a.base),f(a.due)+' прошли дату продления · '+pct(rate(a.due,a.base)),f(a.renew)+' уже продлились · '+pct(rate(a.renew,a.base))],
['База команды · прежний бюджет',money(a.base_money),pct(rate(a.due_money,a.base_money))+' базы ₽ прошли дату продления',pct(rate(a.renew_old_money,a.base_money))+' базы ₽ уже продлились']
].map((k,i)=>'<div class="card kpi"><div class="label">'+k[0]+'</div><div class="value" style="'+(i===3?'font-size:30px':i===1?'font-size:33px':'')+'">'+k[1]+'</div><div class="detail">'+k[2]+'</div><div class="sub">'+k[3]+'</div></div>').join('');
$('#coverage').innerHTML=[['Прошли дату продления',a.due,a.due_money],['Уже продлились после ввода цен',a.renew,a.renew_old_money]].map(([label,n,amount])=>'<div class="card"><div class="topline"><h3>'+label+'</h3><span class="n">'+pct(rate(n,a.base))+'</span></div>'+progress(rate(n,a.base))+'<div class="small"><b>'+f(n)+' / '+f(a.base)+' клиентов</b> · '+money(amount)+' из '+money(a.base_money)+' прежнего бюджета<br><b>'+pct(rate(amount,a.base_money))+'</b> денежной базы команды</div></div>').join('');
$('#scopeNote').innerHTML='* Дополнительная стоимость тарифов за один цикл относительно прежней цены; это не подтверждённая бухгалтерская выручка. Полная база — все клиенты выбранного портфеля с прошлым тарифом в окне 16.09–15.10. '+(g.some(x=>x.virtual)?'Командные итоги включают виртуальный портфель.':'Выбран портфель сотрудников.');
$('#scores').innerHTML=humans.length?humans.map(m=>'<div class="scoreline"><span>'+esc(m.name)+(m.due<10?' <span class="warning">•</span>':'')+'</span><div class="scoretrack"><span style="width:'+(m.renew_rate*.5)+'%;background:var(--blue)"></span><span style="width:'+(m.accept_rate*.3)+'%;background:var(--green)"></span><span style="width:'+(m.safe_rate*.2)+'%;background:var(--purple)"></span></div><b>'+pf.format(m.score)+'</b><span class="tiny '+(m.due<10?'warning':'')+'">n='+m.due+'</span></div>').join(''):'<div class="empty">Виртуальный портфель не оценивается.</div>';
table('#scoretable',['Менеджер','Клиентов<br>к продлению','Конверсия<br>продления','Конверсия<br>принятия ≥15%','Конверсия<br>без снижения','Балл / 100','Выборка'],humans.map(m=>tr([esc(m.name),f(m.due),pct(m.renew_rate),pct(m.accept_rate),pct(m.safe_rate),'<b>'+pf.format(m.score)+'</b>',m.due<10?'<span class="warning">n &lt; 10 · предварительно</span>':'Предварительно'])));
let sorted=[...g.filter(m=>!m.virtual).sort((x,y)=>y.due-x.due),...g.filter(m=>m.virtual)];
const teamScope=$('#scope').value;const teamRows=D.clients.filter(r=>teamScope==='all'||(teamScope==='virtual'?r.virtual:!r.virtual));
const teamSummary={name:teamScope==='all'?'Команда':teamScope==='human'?'Команда · 8 менеджеров':'Виртуальный портфель · итог',team:true,virtual:false,...agg(teamRows)};
const chartRows=[teamSummary,...sorted];
$('#outcomes').innerHTML=chartRows.map(m=>'<div class="outcomerow'+(m.team?' team-summary':'')+'"><span>'+esc(m.virtual?'Виртуальный портфель':m.name)+'</span><div class="stack">'+[['grow','var(--green)'],['flat','var(--blue)'],['drop','var(--orange)'],['non','var(--red)']].map(([k,c])=>'<span title="'+k+': '+m[k]+'" style="width:'+(m[k]/m.due*100)+'%;background:'+c+'">'+(m[k]/m.due>.07?m[k]:'')+'</span>').join('')+'</div><b>'+f(m.due)+'</b></div>').join('');
let countrow=(m,total=false)=>tr([total?'Итого выбранный портфель':esc(m.name),f(m.base),f(m.due),'<b>'+f(m.renew)+'</b>',f(m.accepted),'<span class="pos">'+f(m.grow)+'</span>',f(m.flat),'<span class="neg">'+f(m.drop)+'</span>','<span class="neg">'+f(m.non)+'</span>',pct(m.renew_rate)],total?'total':m.virtual?'virtual':'');
table('#counttable',['Менеджер','Вся<br>база','Наступило<br>продление','Продлились<br>после ввода цен','Приняли<br>≥15%','Выросли<br>лю�