ed=rs.filter(r=>r.adm_paid_after_cutoff);table('#admchanges',['Avito ID','Менеджер','Оплата в ADM','Текущий статус тарифа'],changed.map(r=>tr([esc(r.id),esc(r.manager),longDate(r.adm_paid_after_cutoff),esc(r.adm_current_status)])));
$('#admNote').textContent='Сверка по тем же клиентам, у которых наступило продление в исходном отчёте: '+matched+' из '+rs.length+' статусов совпали. Историческое состояние восстановлено по оплатам, автопродлениям и приостановкам в журнале ADM до 19.10 в 00:00 MSK. Текущий статус проверен 19.10.2026, 22:40–22:41 MSK. Клиенты, у которых срок продления наступил только 19 октября, в эту сверку не добавлялись.';
}
function renderClients(){let r=auditRows();table('#clienttable',['Avito ID','Менеджер','Статус<br>на 18.10','Последнее КП','Статус КП /<br>как закрыто','Последний звонок /<br>встреча','Комментарий последнего<br>звонка / встречи','ADM сейчас<br>19.10, 22:40–22:41','Старая цена','Новая цена','Изменение','Рост','Старый тариф<br>окончание','Новый тариф<br>старт','Простой<br>дней','Потери<br>простоя','Принял<br>≥15%'],r.map(x=>tr(['<a href="https://adm.avito.ru/tariff/info?userId='+encodeURIComponent(x.id)+'" target="_blank" rel="noopener">'+esc(x.id)+'</a>',esc(x.manager),esc(x.status),coCell(x),coStatusCell(x),contactCell(x),commentCell(x),admCell(x),money(x.old),x.new==null?'—':money(x.new),x.delta==null?'—':money(x.delta),x.growth==null?'—':pct(x.growth),date(x.old_end),date(x.new_start),x.non?pf.format(x.idle_days):'—',x.non?money(x.idle_loss):'—',x.accepted?'Да':'Нет'])));
$('#clientCount').textContent='Показано '+r.length+' клиентов. Полные комментарии и CRM-поля включены в CSV; фильтры применяются к выгрузке.';
$('#crmCoverage').innerHTML=[['КП найдено',r.filter(x=>x.co_id).length],['Последний контакт найден',r.filter(x=>x.contact_at).length],['Комментарий заполнен',r.filter(x=>x.contact_comment).length]].map(([label,n])=>'<span class="pill">'+label+': '+n+' / '+r.length+'</span>').join('');
$('#crmFreshness').textContent='Свежесть DWH: КП — 19.10, 06:39; звонки — 19.10, 06:24; встречи — 19.10, 19:52; описания встреч — 19.10, 06:16 MSK. Комментарий звонка — последняя версия из dds.s_bcall_comment. Это последние доступные данные DWH, не проверка текущего состояния CRM в реальном времени.';
}
$('#scope').addEventListener('change',()=>{refill();render()});$('#manager').addEventListener('change',render);$('#search').addEventListener('input',renderClients);$('#status').addEventListener('change',renderClients);$('#print').onclick=()=>window.print();
$('#csv').onclick=()=>{const keys=['id','manager','status','co_id','co_created','co_status','co_result','co_closed','co_stage_changed','co_product','co_title','co_manager','contact_at','contact_type','contact_manager','contact_theme','call_result','billsec','contact_comment','comment_updated','activity_ext_id','adm_current_status','adm_current_non','adm_asof_non','adm_checked_at','adm_paid_after_cutoff','old','new','delta','growth','old_end','new_start','old_size','new_size','idle_days','idle_loss','accepted','cpa','upgrade'];const heads=['Avito ID','Менеджер','Статус на 18.10','ID последнего КП','КП создано','Статус последнего КП','Как закрыто КП','КП закрыто','Статус КП изменён','Продукт КП','Название КП','Ответственный КП','Дата последнего контакта','Тип последнего контакта','Автор контакта','Тема контакта','Результат звонка','Длительность звонка сек','Комментарий последнего контакта','Комментарий обновлён','Внешний ID активности','ADM текущий статус','ADM непролонг сейчас','ADM непролонг на конец 18.10','ADM проверено UTC','ADM оплата после среза','Старая стоимость','Новая стоимость','Изменение ₽','Рост %','Конец старого тарифа','Начало нового тарифа','Старый объём','Новый объём','Простой дней','Потери простоя ₽','Принял ≥15%','CPA','Апгрейд прошлого тарифа'];const quote=v=>'"'+String(v??'').replace(/"/g,'""')+'"';const body=[heads,...auditRows().map(r=>keys.map(k=>r[k]))].map(row=>row.map(quote).join(';')).join('\r\n');let blob=new Blob(['\ufeff'+body],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='MASD_RE_16-18_октября_2026_клиенты.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};

refill();render();window.reportData=D;window.reportReady=true;
