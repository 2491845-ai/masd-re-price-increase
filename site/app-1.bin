�ой %','Без<br>изменения','Продлились<br>со снижением','Текущий<br>непролонг','Конверсия<br>продления'],[countrow(a,true),...sorted.map(m=>countrow(m))]);
$('#donuts').innerHTML=chartRows.map(m=>{const total=m.grow,R=52,C=2*Math.PI*R;let offset=0;let circles=m.bins.map((n,i)=>{let len=total?n/total*C:0;let s='<circle cx="75" cy="75" r="'+R+'" fill="none" stroke="'+colors[i]+'" stroke-width="18" stroke-dasharray="'+len+' '+(C-len)+'" stroke-dashoffset="'+(-offset)+'" transform="rotate(-90 75 75)"><title>'+bandNames[i]+': '+n+' ('+pct(rate(n,total))+')</title></circle>';offset+=len;return s;}).join('');return '<div class="card donut-card'+(m.team?' team-summary-card':'')+'"><div class="donut-title"><h3>'+esc(m.virtual?'Виртуальный портфель':m.name)+'</h3><span class="tiny">'+pct(rate(m.grow,m.renew))+' продлений выросли</span></div><div class="donut-body"><svg class="ring" viewBox="0 0 150 150" role="img" aria-label="Распределение роста: '+esc(m.name)+'"><circle cx="75" cy="75" r="52" fill="none" stroke="#263347" stroke-width="18"/>'+circles+'<text x="75" y="76" text-anchor="middle" style="font-size:30px;font-weight:750">'+total+'</text><text x="75" y="95" text-anchor="middle" style="font-size:10px;fill:var(--muted)">выросли</text></svg><div class="bandlegend">'+m.bins.map((n,i)=>'<div class="bandrow '+(!n?'zero':'')+'"><i class="dot" style="background:'+colors[i]+'"></i><span>'+bandNames[i]+'</span><b>'+n+'</b><span>'+pct(rate(n,total))+'</span></div>').join('')+'</div></div><div class="cardfoot"><span>Рост / наступило продление</span><b>'+m.grow+' / '+m.due+' · '+pct(m.grow_rate)+'</b></div></div>';}).join('');
$('#finance').innerHTML=[['Дополнительная стоимость','+'+money(a.gain),'pos','Сумма положительных изменений · '+a.grow+' клиентов'],['Сокращение стоимости','−'+money(a.reduction),'neg','Сумма снижений · '+a.drop+' клиентов'],['Накопленные потери от простоя','−'+money(a.idle_loss),'neg','Текущий непролонг · '+a.non+' клиентов']].map(([l,v,c,t])=>'<div class="card"><p>'+l+'</p><div class="amount '+c+'">'+v+'</div><p>'+t+'</p></div>').join('');
let moneyrow=(m,total=false)=>tr([total?'Итого выбранный портфель':esc(m.name),'<span class="pos">+'+money(m.gain)+'</span>','<span class="neg">−'+money(m.reduction)+'</span>',money(m.non_money),'<b class="neg">−'+money(m.idle_loss)+'</b>'],total?'total':m.virtual?'virtual':'');
table('#moneytable',['Менеджер','Дополнительная<br>стоимость тарифов','Сокращение<br>стоимости тарифов','Прежний бюджет<br>текущего непролонга','Потери от простоя<br>на конец 18 октября'],[moneyrow(a,true),...sorted.map(m=>moneyrow(m))]);
$('#auditSummary').textContent='Контроль полной выгрузки: '+D.audit.source_rows+' строк истории; '+D.audit.unique_base+' уникальный клиент в базе; дублей ID: '+D.audit.duplicate_ids+'; пропущенных стоимостей в расчётной выборке: '+D.audit.unknown+'. Проверены равенства: продлились + непролонг = наступило продление; выросли + без изменения + снижение = продлились; сумма сегментов диаграмм = выросли.';
renderADM(rows);renderClients();}
function auditRows(){return selected().filter(r=>r.due&&(!$('#search').value||r.id.includes($('#search').value.trim()))&&(!$('#status').value||r.status===$('#status').value)).sort((a,b)=>a.manager.localeCompare(b.manager,'ru')||a.id.localeCompare(b.id));}
function date(s){if(!s)return '—';const [d,t]=s.split('T');return d.split('-').reverse().slice(0,2).join('.')+' '+t.slice(0,5);}
function longDate(s){if(!s)return '—';const datePart=s.slice(0,10).split('-').reverse().join('.');return datePart+(s.includes('T')?' '+s.slice(11,16):'');}
function small(text){return '<span class="tiny">'+esc(text)+'</span>';}
function coCell(x){if(!x.co_id)return '<div class="crm-cell crm-missing">КП не найдено</div>';return '<div class="crm-cell"><b>КП '+esc(x.co_id)+'</b>'+small('Создано '+longDate(x.co_created))+small(x.co_product||'Продукт не указан')+small(x.co_manager||'')+'</div>';}
function coStatusCell(x){if(!x.co_id)return '—';return '<div class="crm-cell"><b class="'+(x.co_stage_group==='success'?'pos':x.co_stage_group==='close_fail'?'neg':'')+'">'+esc(x.co_status||'Статус не указан')+'</b>'+small(x.co_result||x.co_stage_group||'')+small((x.co_closed?'Закрыто '+longDate(x.co_closed):'Статус изменён '+longDate(x.co_stage_changed)))+'</div>';}
function contactCell(x){if(!x.contact_at)return '<div class="crm-cell crm-missing">Контакт не найден</div>';return '<div class="crm-cell"><b>'+esc(x.contact_type)+' · '+longDate(x.contact_at)+'</b>'+small(x.contact_manager||'')+small([x.contact_theme,x.call_result,x.contact_type==='Звонок'&&x.billsec!=null?f(x.billsec)+' сек.':null].filter(Boolean).join(' · '))+'</div>';}
function commentCell(x){if(!x.contact_at)return '<div class="comment-cell crm-missing">Контакт не найден</div>';if(!x.contact_comment)return '<div class="comment-cell crm-missing">У последнего контакта комментарий не заполнен</div>';let text=esc(x.contact_comment);return '<div class="comment-cell">'+(x.contact_comment.length>220?'<details><summary>'+esc(x.contact_comment.slice(0,170))+'… · показать полностью</summary><p class="crm-comment">'+text+'</p></details>':'<p class="crm-comment">'+text+'</p>')+small('Комментарий обновлён '+longDate(x.comment_updated))+'</div>';}
function admCell(x){if(!x.adm_checked_at)return '—';return '<div class="crm-cell"><b class="'+(x.adm_current_non?'neg':'pos')+'">'+esc(x.adm_current_status||x.adm_summary_status)+'</b>'+small(x.adm_paid_after_cutoff?'Оплата после среза: '+longDate(x.adm_paid_after_cutoff):'Проверено '+new Date(x.adm_checked_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow'}))+'</div>';}
function renderADM(rows){if(!D.adm)return;let selectedIds=new Set(rows.filter(r=>r.due).map(r=>r.id)),rs=D.clients.filter(r=>selectedIds.has(r.id)),names=[...new Set(rs.map(r=>r.manager))];let non=rs.filter(r=>r.non).length,now=rs.filter(r=>r.adm_current_non).length,matched=rs.filter(r=>r.non===r.adm_asof_non).length;
$('#admSummary').innerHTML='<div class="adm-conversion"><div><strong>'+non+' = '+rs.filter(r=>r.adm_asof_non).length+'</strong><span> непролонгов на конец 18.10 · отчёт = ADM</span></div><div><strong>'+now+'</strong><span> остаются в непролонге сейчас</span></div><div><strong>'+(non-now)+'</strong><span> оплатили тариф 19.10</span></div></div>';
const cells=m=>{let r=m?rs.filter(x=>x.manager===m):rs;return [m?esc(m):'Итого выбранный портфель',f(r.length),f(r.filter(x=>x.non).length),f(r.filter(x=>x.adm_asof_non).length),f(r.filter(x=>x.adm_current_non).length),f(r.filter(x=>x.adm_paid_after_cutoff).length),'<span class="adm-verified">'+(r.every(x=>x.non===x.adm_asof_non)?'Совпало':'Есть расхождения')+'</span>'];};
table('#admtable',['Менеджер','Проверено<br>клиентов','Отчёт<br>непролонг 18.10','ADM на конец<br>18.10 по истории','ADM сейчас<br>непролонг','Оплатили<br>19.10','Сверка 18.10'],[tr(cells(null),'total'),...names.map(m=>tr(cells(m)))]);
